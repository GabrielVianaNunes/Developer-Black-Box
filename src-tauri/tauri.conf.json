{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Developer Black Box",
  "identifier": "dev.blackbox.local",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Developer Black Box",
        "width": 760,
        "height": 560,
        "minWidth": 420,
        "minHeight": 360,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Gabriel Nunes",
    "copyright": "Copyright (c) 2026 Gabriel Nunes",
    "category": "DeveloperTool",
    "shortDescription": "Caixa-preta local para monitorar processos e investigar falhas, com privacidade em primeiro lugar.",
    "licenseFile": "../LICENSE",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "PortugueseBR"],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
