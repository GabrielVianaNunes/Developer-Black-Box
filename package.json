{
  "name": "developer-blackbox",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "test": "node --experimental-strip-types --no-warnings --test scripts/repo-safety.test.mjs scripts/i18n.test.mjs scripts/version.test.mjs scripts/changelog.test.mjs scripts/sign-release.test.mjs scripts/sign-release-flow.test.mjs scripts/sign-release-config.test.mjs scripts/key-protect.test.mjs",
    "version": "node scripts/version.mjs",
    "check:version": "node scripts/version.mjs check",
    "check:repo": "node scripts/check-tracked.mjs && node scripts/scan-secrets.mjs",
    "check:history": "node scripts/check-tracked.mjs --history && node scripts/scan-secrets.mjs --history"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
